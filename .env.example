# ---------------------------------------------------------------------------
# REDact configuration. Copy to .env and fill in. Never commit .env.
# Production values are marked [prod].
# ---------------------------------------------------------------------------

APP_NAME=REDact
APP_ENV=local                      # [prod] production
APP_KEY=                           # php artisan key:generate (keep it secret and stable)
APP_DEBUG=true                     # [prod] false — never true in production
APP_URL=http://localhost:8000      # [prod] https://redact.example.com (also the passkey relying party)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Comma-separated proxy IPs when behind a reverse proxy / load balancer (VPS with nginx in front: 127.0.0.1)
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily                    # rotating files in storage/logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                    # [prod] warning

# --- Database ---------------------------------------------------------------
DB_CONNECTION=sqlite               # [prod] mysql (MariaDB 10.4+ / MySQL 8)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=redact
# DB_USERNAME=redact
# DB_PASSWORD=

# --- Sessions (database driver: sessions can be listed and revoked) ---------
SESSION_DRIVER=database
SESSION_LIFETIME=120               # idle minutes; the absolute limit is REDACT_SESSION_ABSOLUTE
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false        # [prod] true
SESSION_SAME_SITE=lax
# [prod] SESSION_COOKIE=__Host-redact   (requires HTTPS, path=/ and no domain)

# --- Queue / cache: database drivers work everywhere, including shared hosting
QUEUE_CONNECTION=database          # 'sync' also works (AI drafts then run during the request)
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local              # uploaded documents stay on the private disk

# On shared hosting there is no queue worker: let the scheduler (cron, every minute) drain the queue.
REDACT_QUEUE_VIA_SCHEDULER=false   # [shared hosting] true

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log                    # [prod] smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="REDact"
# The envelope sender (Return-Path) must be exactly no-reply@cetome.com too (DMARC aspf=s). smtp: automatic.
# sendmail: MAIL_MAILER=sendmail and MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i -fno-reply@cetome.com"
# (docs/DEPLOY-shared-hosting.md, Mail).

# --- Contact form (/contact) -------------------------------------------------
REDACT_CONTACT_TO=info@cetome.com  # who receives the messages (Reply-To: the visitor)
REDACT_CONTACT_PER_IP=10           # sends per IP in 15 minutes (every attempt counts)
REDACT_CONTACT_PER_EMAIL=3         # messages per e-mail address in an hour

# --- Content pack (docs/CONTENT-PACK.md). Keep a real pack OUTSIDE the web root. ---------
REDACT_CONTENT_PATH=packs/demo          # the open demo pack (invented, not for real assessments), or your own pack

# --- Accounts ---------------------------------------------------------------
REDACT_SIGNUP=true                 # self-service sign-up
REDACT_SESSION_ABSOLUTE=600        # minutes from sign-in, whatever the activity
REDACT_REMEMBER_DAYS=30            # "Keep me signed in" lasts this many days from sign-in; 0 hides the box
PASSKEYS_USER_HANDLE_SECRET=       # random 64 chars; set once and never change (passkeys depend on it)
ALTCHA_HMAC_KEY=                   # random 64 chars (sign-up proof-of-work)
REDACT_SECURITY_CONTACT=security@example.com

# --- AI (provider and model are never shown to customers) -------------------
# Bring your own key and model. The console's "AI settings" page (super-admin) overrides these.
REDACT_AI_ENABLED=true
REDACT_AI_PROVIDER=gemini          # anthropic (Claude) | openai (ChatGPT) | gemini | mistral | openai_compatible
REDACT_AI_MODEL=gemini-3.5-flash-lite   # free text; empty = the provider's suggested default
REDACT_AI_BASE_URL=                # openai_compatible: the API base URL (e.g. https://llm.example.com/v1); else an optional gateway
REDACT_AI_API_KEY=                 # openai_compatible only (the others use their own variable below)
REDACT_AI_FALLBACK_MODELS=
REDACT_AI_TIMEOUT=90
REDACT_AI_UNITS_PER_DAY=150
REDACT_AI_UNITS_PER_10_MIN=40
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- Plans and billing (docs/BILLING.md) -------------------------------------
REDACT_SELF_HOSTED=                # empty: automatic (self-hosted when billing is off: AI not limited by plans) [prod] false
# The first product of every organisation is free. Each additional product is a unit of
# the Stripe subscription "products". Without the Stripe keys billing is off: the limits
# below apply and the app says "Talk to us" (staff grant extra products in the console).
STRIPE_KEY=                        # pk_test_… / [prod] pk_live_…
STRIPE_SECRET=                     # sk_test_… / [prod] sk_live_… (or a restricted key)
STRIPE_WEBHOOK_SECRET=             # whsec_… of the endpoint https://<host>/stripe/webhook
STRIPE_PRICE_PRODUCT_MONTHLY=      # price_… : 100 EUR per month, recurring, per unit
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=en_IE
REDACT_PRODUCT_PRICE_LABEL="100 €" # shown in the app (excl. VAT)
REDACT_SALES_URL=                  # "Talk to us"; empty: the REDact contact form (/contact?topic=pricing)
# Public repository of the open-source engine (/pricing). Empty: "Coming soon".
REDACT_OPEN_SOURCE_URL=
REDACT_FREE_PRODUCTS=1
REDACT_FREE_TEAM_MEMBERS=1         # people invited to the free product besides its owner
REDACT_FREE_AI_UNITS=0             # no AI on the free plan (a one-time trial if > 0)...
REDACT_FREE_AI_PERIOD=once         # ...once | day | month | year
REDACT_PAID_AI_UNITS=500           # per paid (or granted) product, pooled per organisation...
REDACT_PAID_AI_PERIOD=month
REDACT_ENTERPRISE_AI_UNITS=5000
REDACT_ENTERPRISE_AI_PERIOD=month

# --- Known vulnerabilities (docs/VULNERABILITY-SOURCES.md) -------------------
# EUVD, NVD, OSV.dev and CISA KEV: public, no key needed. An NVD key (free) raises the NVD
# allowance from 5 to 50 requests per 30 s: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
REDACT_VULN_CHECKS=true            # false: no call to any external vulnerability database
REDACT_VULN_AUTO=true              # look components up a minute after they are added or changed by hand
REDACT_VULN_WEEKLY=false           # true: re-check every version in work each Monday 04:00 (from the cron)
REDACT_VULN_USER_AGENT="REDact/1.0 (+https://redact.example.com; security@example.com)"

# --- Retention (days) --------------------------------------------------------
REDACT_RETENTION_REQUEST_LOGS=395
REDACT_RETENTION_ACTIVITY=730
REDACT_RETENTION_SECURITY=365
REDACT_RETENTION_CONTACT=365       # contact form messages

# --- Content Security Policy -------------------------------------------------
CSP_ENABLED=true
CSP_REPORT_URI=

VITE_APP_NAME="${APP_NAME}"

# Sandboxes ("Try REDact") a single network may start per day.
REDACT_GUEST_PER_IP_PER_DAY=5

# HTTP cron (hosts whose cron only calls a URL): GET /cron/<key> runs schedule:run. Empty = off.
REDACT_CRON_KEY=
