{
  "schema": "redact.tree/1",
  "standard": "demo-net",
  "requirement": "UPD-1",
  "clause": "D.2",
  "figure": "Demo tree 2",
  "title": {
    "en": "Software updates (demo)",
    "fr": "Mises à jour logicielles (démo)"
  },
  "scope": {
    "en": "For the product",
    "fr": "Pour le produit"
  },
  "start": "DN-1",
  "nodes": [
    {
      "id": "DN-1",
      "kind": "decision",
      "text": {
        "en": "Can the product's software be changed after it is sold?",
        "fr": "Le logiciel du produit peut-il être modifié après la vente de celui-ci ?"
      },
      "branches": [
        {
          "label": "No",
          "to": "R-NA"
        },
        {
          "label": "Yes",
          "to": "DN-2"
        }
      ]
    },
    {
      "id": "DN-2",
      "kind": "decision",
      "text": {
        "en": "Does the product check where an update comes from before installing it?",
        "fr": "Le produit vérifie-t-il la provenance d’une mise à jour avant de l’installer ?"
      },
      "branches": [
        {
          "label": "Yes",
          "to": "R-PASS"
        },
        {
          "label": "No",
          "to": "R-FAIL"
        }
      ]
    },
    {
      "id": "R-NA",
      "kind": "result",
      "result": "NOT APPLICABLE"
    },
    {
      "id": "R-PASS",
      "kind": "result",
      "result": "PASS"
    },
    {
      "id": "R-FAIL",
      "kind": "result",
      "result": "FAIL"
    }
  ]
}
